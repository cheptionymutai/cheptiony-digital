{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/success",
        "destination": "/success.html"
      },
      {
        "source": "**",
        "destination": "/post.html"
      }
    ]
  }
}