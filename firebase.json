{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/sitemap.xml",
        "destination": "https://cheptiony-backend-838892077100.us-central1.run.app/sitemap.xml?site=cheptiony",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/success",
        "destination": "/success.html"
      },
      {
        "source": "**",
        "destination": "/post.html"
      }
    ]
  }
}